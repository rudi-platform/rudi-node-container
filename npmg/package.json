{
  "name": "rudi-node",
  "private": true,
  "workspaces": [
    "rudi-catalog",
    "rudi-manager",
    "rudi-storage",
    "rudi-jwtauth"
  ],
  "scripts": {
    "install:all": "npm ci --workspaces --include-workspace-root",
    "update:all": "npx npm-check-updates -u -t minor && npm install",
    "run:all": "npm -ws run",
    "exec:all": "npm -ws exec --",
    "test:all": "npm -ws run test",
    "build:all": "npm -ws run build",
    "clean": "rm -rf node_modules package-lock.json && npm install"
  }
}
