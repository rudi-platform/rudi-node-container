# - Building -------------------------------------------------------------------
# Node build stage. Debian-based (glibc) on purpose: the runtime stage below is
# Ubuntu (glibc). Do NOT switch this to alpine here, a musl/glibc mix can break
# any native addon that gets compiled during `npm ci`.
FROM node:26-bookworm-slim AS NodeBuilder
# ------------------------------------------------------------------------------

# derived from BuildKit's TARGETPLATFORM
# "linux/amd64", "linux/arm64" or "windows/amd64"
ARG TARGETPLATFORM
RUN if [ -z "$TARGETPLATFORM" ]; then echo "Error: 'TARGETPLATFORM' is not set. BuildKit is required."; exit 1; fi

# # Optional argument: "linux" or "windows"
# ARG TARGETOS

# # Optional argument: "amd64" or "arm64"
# ARG TARGETARCH

# # Derive OS/ARCH if not explicitly set
# ENV TARGETOS="${TARGETOS:-${TARGETPLATFORM%%/*}}" \
#     TARGETARCH="${TARGETARCH:-${TARGETPLATFORM##*/}}"
# RUN echo "Building for OS=$TARGETOS ARCH=$TARGETARCH"

# Folder that contains the source of every rudi-node module
ARG SRC_DIR="./src"

# Folder that contains the files to install all the modules in the same upper node_modules folder
# ARG NPMIG_DIR="./npmg"

# Explicit npm cache location (important)
ENV NPM_CONFIG_CACHE=/npm-cache

ENV WK_DIR="/app/rudi-node"
ENV INI_DIR="$WK_DIR/ini"
ENV NODE_ENV=production

WORKDIR "$WK_DIR"

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 xz-utils ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY ./env/* "$WK_DIR"/

RUN npm config set registry "https://registry.npmjs.org/" && \
    npm config set fetch-timeout 1000                     && \
    npm config set searchstaleness 3600                   && \
    npm config set package-lock true                      && \
    npm config set progress false                         && \
    npm config set loglevel warn                          && \
    npm i -g npm@12.0.2                                   && \
    npm config set @aqmo.org:registry "https://gitlab.aqmo.org/api/v4/projects/59/packages/npm/"

RUN groupadd -g 5001 rudi         && \
    groupadd -g 5002 rudicatalog  && \
    groupadd -g 5003 rudistorage  && \
    groupadd -g 5005 rudimanager

RUN useradd -M --shell /usr/sbin/nologin -g rudi        -u 5001 rudiadm      && \
    useradd -M --shell /usr/sbin/nologin -g rudicatalog -u 5002 rudicatalog  && \
    useradd -M --shell /usr/sbin/nologin -g rudistorage -u 5003 rudistorage  && \
    useradd -M --shell /usr/sbin/nologin -g rudimanager -u 5005 rudimanager  && \
    usermod -aG rudi        rudicatalog                                      && \
    usermod -aG rudi        rudistorage                                      && \
    usermod -aG rudi        rudimanager                                      && \
    usermod -aG rudicatalog rudiadm                                          && \
    usermod -aG rudistorage rudiadm                                          && \
    usermod -aG rudimanager rudiadm

# ---- Backend dependencies ----
# Only package files first

# 1. Workspace root (from local ./npmci/)
COPY npmci/package*.json ./
# 2. Workspace package manifests only
COPY "${SRC_DIR}/rudi-catalog/package.json" rudi-catalog/
COPY "${SRC_DIR}/rudi-storage/package.json" rudi-storage/
COPY "${SRC_DIR}/rudi-manager/package.json" rudi-manager/

# Run npm install with cache (deduplicates deps via workspaces)
RUN --mount=type=cache,target=/npm-cache,sharing=locked \
    npm ci --workspaces --prefer-offline=false --omit=dev

# ---- Frontend dependencies ----
COPY "${SRC_DIR}/rudi-manager/front/package*.json" rudi-manager/front/
RUN --mount=type=cache,target=/npm-cache,sharing=locked \
    cd "rudi-manager/front" && \
    rm -rf package-lock.json && \
    npm install --no-audit --no-fund --include=dev


# Let's copy the full source (after npm install)
COPY "${SRC_DIR}/rudi-catalog" "${WK_DIR}/rudi-catalog"
COPY "${SRC_DIR}/rudi-storage" "${WK_DIR}/rudi-storage"
COPY "${SRC_DIR}/rudi-manager" "${WK_DIR}/rudi-manager"

# ---- Front-end build (with npm cache) ----
RUN --mount=type=cache,target=/npm-cache,sharing=locked \
    cd "rudi-manager/front" && \
    PUBLIC_URL='' NODE_ENV='development' npm run build:prod

RUN rm -rf \
      "rudi-manager/front/node_modules" \
      "rudi-manager/front/src" \
      $(find . -iname '.docker*' -o -iname '.git*')


RUN chown -R root:rudi        node_modules *.ini *.json && \
    chown -R root:rudicatalog rudi-catalog              && \
    chown -R root:rudistorage rudi-storage              && \
    chown -R root:rudimanager rudi-manager

RUN chmod -R u=rX,g=rX,o= rudi-catalog rudi-storage rudi-manager && \
    chmod -R u=rX,g=rX,o= node_modules *.ini *.json

# ----- Application image ------------------------------------------------------
# Ubuntu noble based (apt-get), ships MongoDB 9.0 + mongosh + mongodump/mongorestore.
# Docker Official image (library/mongo); NOT affected by MongoDB's
# mongodb-community-server non-slim deprecation. Chosen over the community-server
# slim variants: '*ubi*-slim' is ubi-micro (no package manager) and
# '*ubuntu2204-slim' lacks mongodump/mongorestore and is glibc 2.35 (< node 2.36).
FROM mongo:9.0-noble AS system
# ------------------------------------------------------------------------------
# The base image declares ENTRYPOINT ["docker-entrypoint.sh"], CMD ["mongod"],
# VOLUME /data/db /data/configdb and runs as root (drops privileges via gosu).
# We take it over entirely below.

# Version: single source of truth is ./rudinode-version, passed as a build arg by the
# build scripts (they `source`/export it) and forwarded by docker-compose*.yml.
ARG VERSION=dev
LABEL authors="omartine@irisa.fr,lmaurin@irisa.fr,benjamin.de-zordo@irisa.fr" \
      version="${VERSION}" \
      description="RUDI producer node - https://github.com/rudi-platform/rudi-node-container"

USER root

WORKDIR /app

ENV TZ=Europe/Paris

# 'anacron' satisfies logrotate's 'cron | anacron | cron-daemon | systemd-sysv'
# dependency without pulling in cron + systemd (logrotate is driven by `watch`).
RUN echo "Europe/Paris" > /etc/timezone               && \
    DEBIAN_FRONTEND=noninteractive apt-get update     && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates tzdata logrotate openssh-client sqlite3 bc procps net-tools libatomic1 anacron && \
    rm -rf /var/lib/apt/lists/*

# Copy Node.js runtime from builder image (both stages are glibc)
COPY --from=NodeBuilder /usr/local/bin/node /usr/local/bin/node
COPY --from=NodeBuilder /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
RUN node --version && npm --version

RUN groupadd -g 5001 rudi         && \
    groupadd -g 5002 rudicatalog  && \
    groupadd -g 5003 rudistorage  && \
    groupadd -g 5005 rudimanager

RUN useradd -M --shell /usr/sbin/nologin -g rudi        -u 5001 rudiadm      && \
    useradd -M --shell /usr/sbin/nologin -g rudicatalog -u 5002 rudicatalog  && \
    useradd -M --shell /usr/sbin/nologin -g rudistorage -u 5003 rudistorage  && \
    useradd -M --shell /usr/sbin/nologin -g rudimanager -u 5005 rudimanager  && \
    usermod -aG rudi        rudicatalog                                      && \
    usermod -aG rudi        rudistorage                                      && \
    usermod -aG rudi        rudimanager                                      && \
    usermod -aG rudicatalog rudiadm                                          && \
    usermod -aG rudistorage rudiadm                                          && \
    usermod -aG rudimanager rudiadm

WORKDIR /app
ENV WK_DIR="/app/rudi-node"

COPY --from=NodeBuilder "$WK_DIR" "$WK_DIR"

WORKDIR "$WK_DIR"
RUN echo "$WK_DIR"
RUN mkdir -p -m 0770      /data /app/config/ini && \
    chown -R rudiadm:rudi /data /app/config

COPY --chown=root:rudi    --chmod=440 ./ini /app/config/ini
COPY                      --chmod=444 ./install/.profile /etc/profile.d/10-rudi.sh
COPY --chown=root:rudi    --chmod=550 ./install/oci-alpine-startup.sh ./install/env-*  ./

USER rudiadm

RUN ls -lah

# Reset the base image's mongod entrypoint, otherwise it runs instead of our script.
ENTRYPOINT []
CMD ["/app/rudi-node/oci-alpine-startup.sh"]
